{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg_config/triplets",
        "CMAKE_VERBOSE_MAKEFILE": true
      },
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "generator": "Ninja"
    },
    {
      "name": "clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "clang-libcxx",
        "VCPKG_HOST_TRIPLET": "clang-libcxx",
        "ASIO_IO_URING": true,
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld -stdlib=libc++"
      }
    },
    {
      "name": "default-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "ASIO_IO_URING": true
      }
    }
  ]
}
